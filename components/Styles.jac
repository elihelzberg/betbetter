"""App styling kept in Jac; no handwritten JS, TS, Python or CSS files."""
def:pub Styles -> JsxElement {
    return <style>{"""
        *{box-sizing:border-box}body{margin:0;background:#f4f5ef;color:#183b31;font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;font-size:14px}button,input,select{font:inherit}button,a,input,select{outline-offset:4px}button{cursor:pointer}button:disabled{opacity:.55;cursor:wait}a{color:#16674d}.topbar{background:#173d31;color:#fff;padding:22px max(5vw,20px);display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font-weight:750;font-size:22px;letter-spacing:-1px}.brand span{color:#bde18e}.topbar small{color:#d0dfd3}.status{background:#31513a;border:1px solid #769267;padding:7px 12px;border-radius:30px;font-size:12px;color:#e4f7c4}.shell{max-width:1320px;margin:auto;padding:38px 5vw 50px}.eyebrow{font-size:11px;font-weight:750;letter-spacing:2px;color:#658474}.hero{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:26px}h1{font-size:clamp(30px,4vw,49px);letter-spacing:-2px;line-height:1.12;margin:10px 0 16px}h2{font-size:21px;letter-spacing:-.5px;margin:7px 0}h3{font-size:15px;margin-top:24px}.hero p{color:#66746b;font-size:16px;line-height:1.7;max-width:650px}.hero-mark{font-size:66px;background:#e2ead3;border-radius:26px;padding:22px 34px;color:#386342;transform:rotate(-5deg)}.notice{background:#f2eddb;color:#6c5830;border:1px solid #e3dac0;padding:14px 18px;border-radius:10px;line-height:1.6;margin-bottom:25px}.panel{background:#fff;border:1px solid #dfe5da;border-radius:14px;padding:24px;margin-bottom:22px;box-shadow:0 3px 10px #183b3103}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px}.tag{background:#edf2e6;border-radius:6px;padding:6px 9px;font-size:11px;white-space:nowrap}.filters{display:grid;grid-template-columns:1fr .8fr .8fr 1.6fr 1.7fr auto;gap:12px;align-items:end;margin-bottom:22px}label{display:flex;flex-direction:column;gap:7px;font-size:12px;font-weight:650;color:#56705e}input,select{width:100%;background:#fbfcf8;border:1px solid #d6dfd0;border-radius:7px;padding:10px;color:#183b31;min-height:40px}button.primary{background:#24563f;color:#fff;border:0;border-radius:7px;padding:11px 18px;min-height:40px;font-weight:650}button.link{border:0;background:none;color:#246145;padding:0;text-align:left;font-weight:700;font-size:14px;text-decoration:underline;text-underline-offset:3px}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;text-align:left;white-space:nowrap}th{font-size:11px;text-transform:uppercase;letter-spacing:.7px;color:#7c887d;padding:13px 12px;border-bottom:1px solid #dfe5da;background:#f8faf5}td{padding:17px 12px;border-bottom:1px solid #edf0e8;font-variant-numeric:tabular-nums}td small{display:block;color:#899187;font-size:11px;margin-top:5px}tr:last-child td{border-bottom:0}.ev{font-weight:750;color:#2b6448}.muted{color:#7b887d;font-size:12px;line-height:1.7}.bottom-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:22px}.bottom-grid .panel{margin-bottom:0}.question-form{display:flex;gap:10px;margin:16px 0}.question-form input{flex:1}.answer{line-height:1.7;background:#f2f6ec;padding:15px;border-radius:8px}.answer li{margin:9px 0}.method p{font-size:13px;line-height:1.8;color:#607262}.formula{padding:12px;background:#f3f6ef;border-radius:7px;font-family:ui-monospace,monospace;font-size:12px}.error{background:#fff0ec;border:1px solid #e5b9a7;border-radius:8px;padding:15px;margin-bottom:15px;color:#843f2d}.empty{text-align:center;padding:35px;color:#718071}.detail-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:20px}.detail-stats small{display:block;color:#738675;font-size:11px}.detail-stats strong{display:block;font-size:23px;margin-top:6px}footer{text-align:center;margin-top:28px;color:#819080;font-size:12px}@media(max-width:1000px){.filters{grid-template-columns:repeat(3,1fr)}.bottom-grid{grid-template-columns:1fr}.hero-mark{display:none}}@media(max-width:600px){.shell{padding:25px 16px}.panel{padding:17px}.filters{grid-template-columns:1fr 1fr}.detail-stats{grid-template-columns:1fr 1fr}.topbar small{display:none}.question-form{flex-direction:column}.section-heading{align-items:flex-start}h1{letter-spacing:-1px}.tag{white-space:normal}}
    """}</style>;
}
